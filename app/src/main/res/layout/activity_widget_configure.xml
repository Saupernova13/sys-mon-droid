<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a per-plug widget is dropped on the home screen: pick its plug. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sysmon_window_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_title"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/configure_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/configure_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:divider="@color/widget_outline"
        android:dividerHeight="1dp" />
</LinearLayout>
