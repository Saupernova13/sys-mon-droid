<?xml version="1.0" encoding="utf-8"?>
<!--
  Every plug in one tile. The header shows the aggregate draw and doubles as the
  refresh button; each row's pill toggles that plug.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/list_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_all_plugs_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/list_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_power"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/list_stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/plug_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/widget_outline"
        android:dividerHeight="1dp" />

    <!-- Shown via setEmptyView when there is nothing to list (signed out,
         offline before the first read, or no plugs configured). -->
    <TextView
        android:id="@+id/list_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="12sp" />
</LinearLayout>
