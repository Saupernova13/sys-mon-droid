<?xml version="1.0" encoding="utf-8"?>
<!-- A switch that has been asked for but not yet confirmed: outlined in the
     power accent, so it reads as heading towards ON without claiming to be
     there. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface_variant" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_power" />
</shape>
