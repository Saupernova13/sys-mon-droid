<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SysMonApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SysMonDroid"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SysMonDroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging: receives heater alerts (data messages). -->
        <service
            android:name=".core.push.SysMonMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fallback channel for any notification-type FCM message. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="plug_alerts" />

        <!-- Notification "Stop" action target. -->
        <receiver
            android:name=".core.push.StopPlugReceiver"
            android:exported="false" />

        <!-- ── Home-screen plug widgets ──────────────────────────────────────
             These work with the app closed: they read the persisted session,
             renew the JWT when it nears expiry, and talk to the server
             themselves. -->

        <!-- One plug per tile; the plug is chosen when the widget is dropped. -->
        <receiver
            android:name=".widget.SinglePlugWidgetProvider"
            android:exported="false"
            android:label="@string/widget_plug_single_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_plug_single_info" />
        </receiver>

        <!-- Every plug in one resizable tile. -->
        <receiver
            android:name=".widget.AllPlugsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_plugs_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_plugs_list_info" />
        </receiver>

        <!-- Toggle / refresh taps from either widget. -->
        <receiver
            android:name=".widget.PlugWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.raavivi.sysmon.widget.TOGGLE" />
                <action android:name="com.raavivi.sysmon.widget.REFRESH" />
            </intent-filter>
        </receiver>

        <!-- Rows for the all-plugs widget. BIND_REMOTEVIEWS keeps the launcher
             the only caller that can bind it. -->
        <service
            android:name=".widget.PlugListRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".widget.PlugWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.SysMonDroid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
