# Normalise line endings so the repo is consistent across platforms.
* text=auto

# Shell scripts (incl. the Gradle wrapper) must stay LF to run on Linux/macOS.
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files must stay CRLF.
*.bat text eol=crlf

# Binary assets — never touch.
*.jar binary
*.png binary
*.webp binary
*.keystore binary
*.jks binary
